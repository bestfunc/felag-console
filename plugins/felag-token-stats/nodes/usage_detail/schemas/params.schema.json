{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "用量明细",
  "required": ["from", "to"],
  "properties": {
    "from": { "type": "string", "title": "起始日期(本地日历日,含)", "description": "YYYY-MM-DD" },
    "to": { "type": "string", "title": "结束日期(本地日历日,含)", "description": "YYYY-MM-DD" },
    "tz": { "type": "string", "title": "时区", "default": "Asia/Shanghai" },
    "model": { "type": "string", "title": "只看某个模型" },
    "user_id": { "type": "string", "title": "只看某个员工(平台 users.id)" },
    "page": { "type": "integer", "title": "页码(从 1 起)", "default": 1, "minimum": 1 },
    "page_size": { "type": "integer", "title": "每页条数", "default": 50, "minimum": 1, "maximum": 200 }
  }
}
