{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "连接配置",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "type": "object",
      "title": "配置项",
      "properties": {
        "felag_server_base": {
          "type": "string",
          "title": "felag-server 基址",
          "description": "如 http://felag-server:28080"
        },
        "felag_model_admin_token": {
          "type": "string",
          "title": "共享服务令牌",
          "description": "需与 felag-server 的 FELAG_MODEL_ADMIN_TOKEN 同值"
        }
      }
    }
  }
}
